<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>SecuroBox</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>SecuroBox</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>SecuroBox needs access to your photo library so you can import videos, images and audio files into your private vault.</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>SecuroBox needs permission to save media you export from your private vault.</string>
		<key>NSCameraUsageDescription</key>
		<string>SecuroBox uses the camera for in-app Secure Capture (taking photos or recording videos directly into your encrypted vault) and, only if you enable them, optional break-in detection and Face Unlock. Captures stay on your device.</string>
		<key>NSFaceIDUsageDescription</key>
		<string>SecuroBox uses Face ID to unlock the app and your private media vault.</string>
		<key>NSDocumentsFolderUsageDescription</key>
		<string>SecuroBox needs access to your Documents folder so you can import files into your private vault.</string>
		<key>NSAppleMusicUsageDescription</key>
		<string>SecuroBox needs access to your media library if you choose to import audio.</string>
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
		</array>
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>mailto</string>
			<string>https</string>
		</array>
		<key>UIFileSharingEnabled</key>
		<false/>
		<key>LSSupportsOpeningDocumentsInPlace</key>
		<false/>
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
	</dict>
</plist>
