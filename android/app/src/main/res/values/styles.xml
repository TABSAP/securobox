<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">

        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>


    <style name="LaunchTheme.Calculator">
        <item name="android:windowBackground">@drawable/launch_background_calculator</item>
    </style>
    <style name="LaunchTheme.Notes">
        <item name="android:windowBackground">@drawable/launch_background_notes</item>
    </style>
    <style name="LaunchTheme.Weather">
        <item name="android:windowBackground">@drawable/launch_background_weather</item>
    </style>
    <style name="LaunchTheme.Compass">
        <item name="android:windowBackground">@drawable/launch_background_compass</item>
    </style>
    <style name="LaunchTheme.Utilities">
        <item name="android:windowBackground">@drawable/launch_background_utilities</item>
    </style>
</resources>
